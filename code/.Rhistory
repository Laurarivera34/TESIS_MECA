}
# ================================================================
# 11. APLICAR DIAGNÓSTICO
# ================================================================
diagnostico_buen_gobierno <- diagnostico_univariado(
base_buen_gobierno
)
diagnostico_caracteristicas <- diagnostico_univariado(
base_caracteristicas
)
# ================================================================
# 12. REVISAR DIAGNÓSTICO
# ================================================================
View(diagnostico_buen_gobierno)
View(diagnostico_caracteristicas)
# ================================================================
# 13. IDENTIFICAR VARIABLES CON ALTO MISSING
# ================================================================
diagnostico_buen_gobierno %>%
arrange(desc(porcentaje_missing)) %>%
print(n = Inf)
diagnostico_caracteristicas %>%
arrange(desc(porcentaje_missing)) %>%
print(n = Inf)
# ================================================================
# 14. IDENTIFICAR POSIBLES VALORES EXTREMOS
# ================================================================
# ------------------------------------------------
# 14.1. Buen Gobierno
# ------------------------------------------------
diagnostico_buen_gobierno %>%
filter(tipo %in% c("numeric", "integer")) %>%
select(
variable,
minimo,
p1,
p25,
mediana,
media,
p75,
p99,
maximo,
desviacion_estandar
) %>%
print(n = Inf)
# ------------------------------------------------
# 14.2. Características Generales
# ------------------------------------------------
diagnostico_caracteristicas %>%
filter(tipo %in% c("numeric", "integer")) %>%
select(
variable,
minimo,
p1,
p25,
mediana,
media,
p75,
p99,
maximo,
desviacion_estandar
) %>%
print(n = Inf)
# ================================================================
# 15. GUARDAR BASES ANALÍTICAS EN CSV
# ================================================================
write_csv(
base_buen_gobierno,
file.path(
processed,
"base_buen_gobierno_variables.csv"
),
na = ""
)
write_csv(
base_caracteristicas,
file.path(
processed,
"base_caracteristicas_variables.csv"
),
na = ""
)
# ================================================================
# 16. GUARDAR DIAGNÓSTICOS EN CSV
# ================================================================
write_csv(
diagnostico_buen_gobierno,
file.path(
tables,
"diagnostico_buen_gobierno.csv"
),
na = ""
)
write_csv(
diagnostico_caracteristicas,
file.path(
tables,
"diagnostico_caracteristicas.csv"
),
na = ""
)
View(diagnostico_buen_gobierno)
# ================================================================
# 03_ESTADISTICAS
# ESTADÍSTICAS DESCRIPTIVAS Y ANÁLISIS EXPLORATORIO
# ================================================================
# ================================================================
# 1. LIMPIAR ENTORNO
# ================================================================
rm(list = ls())
# ================================================================
# 2. PAQUETES
# ================================================================
paquetes <- c(
"tidyverse",
"here",
"readr"
)
paquetes_faltantes <- paquetes[
!paquetes %in% rownames(installed.packages())
]
if (length(paquetes_faltantes) > 0) {
install.packages(paquetes_faltantes)
}
invisible(
lapply(paquetes, library, character.only = TRUE)
)
# ================================================================
# 3. RUTAS
# ================================================================
root <- here::here()
processed <- here::here(
"data",
"processed"
)
tables <- here::here(
"output",
"tables"
)
figures <- here::here(
"output",
"figures"
)
# ================================================================
# 4. CREAR CARPETAS SI NO EXISTEN
# ================================================================
dir.create(tables, recursive = TRUE, showWarnings = FALSE)
dir.create(figures, recursive = TRUE, showWarnings = FALSE)
# ================================================================
# 5. IMPORTAR BASES ANALÍTICAS
# ================================================================
base_buen_gobierno <- read_csv(
file.path(
processed,
"base_buen_gobierno_variables.csv"
),
show_col_types = FALSE
)
base_caracteristicas <- read_csv(
file.path(
processed,
"base_caracteristicas_variables.csv"
),
show_col_types = FALSE
)
# ================================================================
# 6. INSPECCIÓN
# ================================================================
dim(base_buen_gobierno)
dim(base_caracteristicas)
names(base_buen_gobierno)
names(base_caracteristicas)
# ================================================================
# 7. ESTADÍSTICAS DESCRIPTIVAS
# ================================================================
estadisticas_numericas <- function(data) {
data %>%
select(where(is.numeric)) %>%
summarise(
across(
everything(),
list(
observaciones = ~ sum(!is.na(.x)),
missing = ~ sum(is.na(.x)),
porcentaje_missing = ~ mean(is.na(.x)) * 100,
minimo = ~ min(.x, na.rm = TRUE),
p1 = ~ quantile(.x, 0.01, na.rm = TRUE),
p25 = ~ quantile(.x, 0.25, na.rm = TRUE),
media = ~ mean(.x, na.rm = TRUE),
mediana = ~ median(.x, na.rm = TRUE),
p75 = ~ quantile(.x, 0.75, na.rm = TRUE),
p99 = ~ quantile(.x, 0.99, na.rm = TRUE),
maximo = ~ max(.x, na.rm = TRUE),
desviacion_estandar = ~ sd(.x, na.rm = TRUE)
),
.names = "{.col}__{.fn}"
)
) %>%
pivot_longer(
cols = everything(),
names_to = c("variable", "estadistica"),
names_sep = "__",
values_to = "valor"
) %>%
pivot_wider(
names_from = estadistica,
values_from = valor
)
}
# ================================================================
# 8. ESTADÍSTICAS BUEN GOBIERNO
# ================================================================
estadisticas_buen_gobierno <- estadisticas_numericas(
base_buen_gobierno
)
write_csv(
estadisticas_buen_gobierno,
file.path(
tables,
"estadisticas_buen_gobierno.csv"
)
)
# ================================================================
# 9. ESTADÍSTICAS CARACTERÍSTICAS GENERALES
# ================================================================
estadisticas_caracteristicas <- estadisticas_numericas(
base_caracteristicas
)
write_csv(
estadisticas_caracteristicas,
file.path(
tables,
"estadisticas_caracteristicas.csv"
)
)
# ================================================================
# 10. DISTRIBUCIÓN DE VARIABLES CATEGÓRICAS
# ================================================================
# ------------------------------------------------
# 10.1. Categoría de desempeño fiscal
# ------------------------------------------------
tabla_categoria <- base_buen_gobierno %>%
count(df2_categoria, sort = TRUE) %>%
mutate(
porcentaje = n / sum(n) * 100
)
write_csv(
tabla_categoria,
file.path(
tables,
"distribucion_df2_categoria.csv"
)
)
# ------------------------------------------------
# 10.2. Rango de desempeño fiscal
# ------------------------------------------------
tabla_rango <- base_buen_gobierno %>%
count(df2_rango, sort = TRUE) %>%
mutate(
porcentaje = n / sum(n) * 100
)
write_csv(
tabla_rango,
file.path(
tables,
"distribucion_df2_rango.csv"
)
)
# ================================================================
# 11. DISTRIBUCIÓN DE VARIABLES DUMMY REGIONALES
# ================================================================
variables_region <- c(
"gandina",
"gcaribe",
"gpacifica",
"gorinoquia",
"gamazonia"
)
tabla_regiones <- base_caracteristicas %>%
select(all_of(variables_region)) %>%
pivot_longer(
cols = everything(),
names_to = "region",
values_to = "dummy"
) %>%
count(region, dummy) %>%
group_by(region) %>%
mutate(
porcentaje = n / sum(n) * 100
) %>%
ungroup()
write_csv(
tabla_regiones,
file.path(
tables,
"distribucion_regiones.csv"
)
)
# ================================================================
# 12. GRÁFICOS DE DISTRIBUCIÓN
# ================================================================
# ------------------------------------------------
# Función para generar histogramas
# ------------------------------------------------
graficar_histograma <- function(
data,
variable,
nombre_archivo
) {
p <- ggplot(
data,
aes(
x = .data[[variable]]
)
) +
geom_histogram(
bins = 40,
na.rm = TRUE
) +
labs(
title = paste(
"Distribución de",
variable
),
x = variable,
y = "Frecuencia"
) +
theme_minimal()
ggsave(
file.path(
figures,
nombre_archivo
),
p,
width = 8,
height = 5,
dpi = 300
)
}
