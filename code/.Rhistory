# 12. Verificar la fórmula y la escala de sostenibilidad_proxy
auditoria_sost <- subset(
panel,
is.finite(sostenibilidad_proxy) &
is.finite(deuda_proxy) &
is.finite(ingresos_corrientes_previos) &
ingresos_corrientes_previos > 0 &
deuda_proxy != 0
)
razon <- with(auditoria_sost, deuda_proxy / ingresos_corrientes_previos)
valor <- auditoria_sost$sostenibilidad_proxy
c(
observaciones_comparables = length(razon),
coincidencia_como_proporcion_pct =
100 * mean(abs(valor / razon - 1) < 0.01),
coincidencia_como_porcentaje_pct =
100 * mean(abs(valor / (100 * razon) - 1) < 0.01)
)
# SEGUNDO BLOQUE: INDICADOR DE SOSTENIBILDIAD
