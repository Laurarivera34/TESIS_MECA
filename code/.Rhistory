position = position_stack(reverse = TRUE),
colour = "white",
linewidth = 0.25,
alpha = 0.92,
na.rm = TRUE
) +
geom_line(
data = totales_top4,
aes(x = ano, y = total_anual, group = 1),
inherit.aes = FALSE,
colour = "#193C8C",
linewidth = 0.85
) +
geom_text(
aes(label = etiqueta_segmento, colour = ciudad),
position = position_stack(vjust = 0.5, reverse = TRUE),
size = 2.7,
show.legend = FALSE,
na.rm = TRUE
) +
geom_text(
data = totales_top4,
aes(x = ano, y = total_anual, label = formato_intereses(total_anual)),
inherit.aes = FALSE,
vjust = -0.65,
size = 3.2,
fontface = "bold",
colour = "#193C8C"
) +
scale_fill_manual(values = paleta_ciudades) +
scale_colour_manual(values = colores_etiquetas) +
scale_x_continuous(
breaks = anios_intereses,
expand = expansion(add = 0.55)
) +
scale_y_continuous(
labels = scales::label_number(decimal.mark = ",", big.mark = "."),
expand = expansion(mult = c(0, 0.13))
) +
labs(
title = "Gasto en intereses de la deuda municipal, 2002–2023",
subtitle = "Cuatro municipios con mayor gasto acumulado · Billones de pesos constantes de 2023",
x = NULL,
y = NULL,
fill = NULL,
caption = paste(
"Fuente: Panel Buen Gobierno del CEDE. Cálculos propios.",
sep = "\n"
)
) +
theme_minimal(base_size = 12) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5),
plot.subtitle = element_text(hjust = 0.5, colour = "grey35"),
legend.position = "top",
axis.text.x = element_text(size = 8, colour = "grey35"),
panel.grid.major.y = element_line(colour = "#E2E5EA"),
panel.grid.major.x = element_blank(),
panel.grid.minor = element_blank(),
plot.caption = element_text(hjust = 0, colour = "grey35", size = 9)
)
# 1. Clasificar los municipios según el saldo estimado de 2023
tolerancia_deuda <- 1e-8
deuda_municipal_2023 <- base %>%
filter(ano == 2023, !is.na(codmpio)) %>%
transmute(
codmpio = stringr::str_pad(
trimws(as.character(codmpio)), width = 5, pad = "0"
),
deuda_proxy
) %>%
distinct() %>%
mutate(
estado_deuda = case_when(
!is.finite(deuda_proxy) ~ NA_character_,
deuda_proxy > tolerancia_deuda ~ "Sí",
abs(deuda_proxy) <= tolerancia_deuda ~ "No",
TRUE ~ NA_character_
)
)
if (anyDuplicated(deuda_municipal_2023$codmpio) > 0) {
stop("Hay municipios con más de un valor de deuda_proxy en 2023.")
}
if (any(deuda_municipal_2023$deuda_proxy < -tolerancia_deuda, na.rm = TRUE)) {
warning("Hay saldos estimados negativos. Esos municipios quedan sin relleno.")
}
# 2. Leer los polígonos municipales del DANE
ruta_municipios <- here::here("input", "geografia", "MGN_MPIO_POLITICO.shp")
if (!file.exists(ruta_municipios)) {
ruta_municipios <- file.choose()
}
