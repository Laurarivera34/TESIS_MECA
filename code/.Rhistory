alpha = 0.85
) +
# Escala de colores
scale_color_gradient(
low = "#F2D5D5",
high = "#8B1E2D",
name = "Dependencia\ndel SGP (%)"
) +
# Proyección cartográfica
coord_sf(
xlim = c(-82, -66),
ylim = c(-5, 14),
expand = FALSE
) +
# Títulos
labs(
title = "Figura 1. Distribución territorial de la dependencia del SGP",
subtitle = "Municipios de Colombia, mediana 2002–2023",
x = NULL,
y = NULL,
caption = paste0(
"Nota: Cada punto representa un municipio. ",
"La dependencia corresponde a la mediana municipal ",
"del SGP como porcentaje de los ingresos totales.\n",
"Fuente: CEDE, TerriData y cartografía GADM. ",
"Cálculos propios."
)
) +
# Estilo académico
theme_void(base_size = 12) +
theme(
text = element_text(family = "serif"),
plot.title = element_text(
size = 13,
face = "bold"
),
plot.subtitle = element_text(size = 11),
plot.caption = element_text(
size = 9,
hjust = 0,
margin = margin(t = 12)
),
legend.position = "right",
legend.title = element_text(size = 10),
legend.text = element_text(size = 9),
plot.margin = margin(15, 15, 15, 15)
)
# 4. Visualizar
print(mapa_dependencia_sgp)
# 5. Guardar imagen
ggsave(
filename = file.path(figures, "mapa_dependencia_sgp_final.png"),
plot = mapa_dependencia_sgp,
width = 10,
height = 8,
dpi = 300,
bg = "white"
)
################ FIGURA 3: DEPENDENCIA DEL SGP Y CRÉDITO
# 1. Clasificar municipios en cuartiles según su
# dependencia mediana del SGP, 2002–2023
grupos_sgp <- dependencia_municipal %>%
filter(!is.na(dependencia_mediana)) %>%
mutate(
cuartil_sgp = ntile(dependencia_mediana, 4),
grupo_sgp = factor(
cuartil_sgp,
levels = 1:4,
labels = c(
"Baja",
"Media-baja",
"Media-alta",
"Alta"
)
)
) %>%
select(codmpio, grupo_sgp)
# 2. Unir clasificación con el panel original
credito_sgp <- base %>%
filter(between(ano, 2002, 2023)) %>%
left_join(grupos_sgp, by = "codmpio") %>%
filter(
!is.na(grupo_sgp),
!is.na(dummy_credito),
dummy_credito %in% c(0, 1)
)
# 3. Calcular utilización del crédito por grupo
resumen_credito_sgp <- credito_sgp %>%
group_by(grupo_sgp) %>%
summarise(
municipios = n_distinct(codmpio),
observaciones = n(),
observaciones_con_credito = sum(dummy_credito == 1),
porcentaje_credito = 100 * mean(dummy_credito),
.groups = "drop"
)
print(resumen_credito_sgp)
# 4. Elaborar gráfico
figura_3 <- ggplot(
resumen_credito_sgp,
aes(
x = grupo_sgp,
y = porcentaje_credito
)
) +
geom_col(
fill = "#8B1E2D",
width = 0.65
) +
geom_text(
aes(
label = paste0(
round(porcentaje_credito, 1), "%"
)
),
vjust = -0.5,
size = 4,
family = "serif"
) +
scale_y_continuous(
limits = c(
0,
max(resumen_credito_sgp$porcentaje_credito) * 1.15
),
labels = function(x) paste0(x, "%")
) +
labs(
title = paste(
"Figura 3. Utilización del crédito municipal",
"según dependencia del SGP"
),
subtitle = "Municipios de Colombia, 2002–2023",
x = "Nivel de dependencia del SGP",
y = "Municipios-año con desembolsos (%)",
caption = paste0(
"Nota: Los municipios se clasifican en cuartiles ",
"según su dependencia mediana del SGP durante ",
"2002–2023. La utilización corresponde al porcentaje ",
"de observaciones municipio-año con desembolsos ",
"positivos. Se excluyen registros sin información ",
"de crédito.\n",
"Fuente: CEDE y TerriData. Cálculos propios."
)
) +
theme_classic(base_size = 12) +
theme(
text = element_text(family = "serif"),
plot.title = element_text(
size = 13,
face = "bold"
),
plot.subtitle = element_text(size = 11),
plot.caption = element_text(
size = 9,
hjust = 0
),
axis.title.x = element_blank(),
plot.margin = margin(15, 15, 15, 15)
)
print(figura_3)
ggsave(
filename = file.path(
figures,
"figura_3_credito_dependencia_sgp.png"
),
plot = figura_3,
width = 9,
height = 6,
dpi = 300,
bg = "white"
)
################ FIGURA 2: MAPA SGP POR CATEGORÍA LEY 617
# 1. Identificar categoría fiscal más frecuente
categoria_municipal <- base %>%
filter(
between(ano, 2002, 2023),
!is.na(categ_cgn),
!is.na(codmpio)
) %>%
count(codmpio, categ_cgn, name = "anos_categoria") %>%
group_by(codmpio) %>%
arrange(
desc(anos_categoria),
categ_cgn,
.by_group = TRUE
) %>%
slice(1) %>%
ungroup() %>%
transmute(
codmpio,
categoria_617 = as.character(categ_cgn)
)
# 2. Unir categorías con datos geográficos
mapa_categoria_sgp <- mapa_sgp %>%
left_join(
categoria_municipal,
by = "codmpio"
) %>%
filter(!is.na(categoria_617))
# 3. Revisar categorías disponibles
mapa_categoria_sgp %>%
count(categoria_617) %>%
print(n = Inf)
# 4. Crear mapa de paneles
figura_2 <- ggplot() +
geom_sf(
data = departamentos_sf,
fill = "#FAFAFA",
color = "#D0D0D0",
linewidth = 0.2
) +
geom_point(
data = mapa_categoria_sgp,
aes(
x = longitud,
y = latitud,
color = dependencia_mediana
),
size = 0.9,
alpha = 0.85
) +
scale_color_gradient(
low = "#F2D5D5",
high = "#8B1E2D",
name = "Dependencia\nSGP (%)"
) +
facet_wrap(
~ categoria_617,
ncol = 3
) +
coord_sf(
xlim = c(-82, -66),
ylim = c(-5, 14),
expand = FALSE
) +
labs(
title = paste(
"Figura 2. Distribución territorial de la",
"dependencia del SGP por categoría fiscal"
),
subtitle = "Municipios de Colombia, 2002–2023",
x = NULL,
y = NULL,
caption = paste0(
"Nota: Cada punto representa un municipio. ",
"El color indica la mediana municipal de dependencia ",
"del SGP. La categoría Ley 617 corresponde a la ",
"clasificación más frecuente del municipio durante ",
"el período con información disponible.\n",
"Fuente: CEDE, TerriData y cartografía GADM. ",
"Cálculos propios."
)
) +
theme_void(base_size = 12) +
theme(
text = element_text(family = "serif"),
plot.title = element_text(
size = 13,
face = "bold"
),
plot.subtitle = element_text(size = 11),
strip.text = element_text(
size = 11,
face = "bold"
),
legend.position = "right",
plot.caption = element_text(
size = 9,
hjust = 0
),
panel.spacing = grid::unit(0.8, "lines"),
plot.margin = margin(15, 15, 15, 15)
)
print(figura_2)
ggsave(
filename = file.path(
figures,
"figura_2_mapa_sgp_categoria_617.png"
),
plot = figura_2,
width = 13,
height = 10,
dpi = 300,
bg = "white"
)
################ FIGURA 2: UTILIZACIÓN TERRITORIAL DEL CRÉDITO
# 1. Calcular frecuencia de desembolsos por municipio
uso_credito_municipal <- base %>%
filter(
between(ano, 2002, 2023),
!is.na(codmpio)
) %>%
group_by(codmpio) %>%
summarise(
municipio = first(municipio),
depto = first(depto),
anos_observados = sum(!is.na(dummy_credito)),
anos_con_credito = sum(dummy_credito == 1, na.rm = TRUE),
frecuencia_credito = if_else(
anos_observados > 0,
100 * anos_con_credito / anos_observados,
NA_real_
),
.groups = "drop"
) %>%
mutate(
grupo_credito = case_when(
is.na(frecuencia_credito) ~ "Sin información",
frecuencia_credito == 0 ~ "Sin desembolsos",
frecuencia_credito <= 25 ~ "Ocasional",
frecuencia_credito <= 50 ~ "Intermedia",
TRUE ~ "Frecuente"
),
grupo_credito = factor(
grupo_credito,
levels = c(
"Sin desembolsos",
"Ocasional",
"Intermedia",
"Frecuente",
"Sin información"
)
)
)
# 2. Incorporar coordenadas
mapa_credito <- uso_credito_municipal %>%
left_join(coordenadas, by = "codmpio") %>%
filter(
between(longitud, -82, -66),
between(latitud, -5, 14)
)
# 3. Revisar distribución
resumen_uso_credito <- uso_credito_municipal %>%
count(grupo_credito, name = "municipios") %>%
mutate(
porcentaje = round(
100 * municipios / sum(municipios), 1
)
)
print(resumen_uso_credito)
# 4. Crear mapa
figura_credito <- ggplot() +
geom_sf(
data = departamentos_sf,
fill = "#FAFAFA",
color = "#D0D0D0",
linewidth = 0.25
) +
geom_point(
data = mapa_credito,
aes(
x = longitud,
y = latitud,
color = grupo_credito
),
size = 1.2,
alpha = 0.85
) +
scale_color_manual(
values = c(
"Sin desembolsos" = "#D9D9D9",
"Ocasional" = "#F1C4C4",
"Intermedia" = "#C66B70",
"Frecuente" = "#8B1E2D",
"Sin información" = "#777777"
),
drop = FALSE,
name = "Utilización del crédito"
) +
coord_sf(
xlim = c(-82, -66),
ylim = c(-5, 14),
expand = FALSE
) +
labs(
title = "Figura 2. Distribución territorial de la utilización del crédito municipal",
subtitle = "Colombia, 2002–2023",
x = NULL,
y = NULL,
caption = paste0(
"Nota: La frecuencia corresponde al porcentaje de años ",
"con desembolsos positivos entre los años con información. ",
"Ocasional: >0–25%; intermedia: >25–50%; ",
"frecuente: >50%. La ausencia de desembolsos ",
"no implica ausencia de deuda.\n",
"Fuente: CEDE y cartografía GADM. Cálculos propios."
)
) +
theme_void(base_size = 12) +
theme(
text = element_text(family = "serif"),
plot.title = element_text(size = 13, face = "bold"),
plot.subtitle = element_text(size = 11),
plot.caption = element_text(size = 9, hjust = 0),
legend.position = "right",
plot.margin = margin(15, 15, 15, 15)
)
print(figura_credito)
# 5. Exportar
ggsave(
filename = file.path(figures, "figura_2_mapa_utilizacion_credito.png"),
plot = figura_credito,
width = 10,
height = 8,
dpi = 300,
bg = "white"
)
################ TERCERA PARTE: SGP Y ESFUERZO FISCAL
# FIGURA 3A. SGP Y RECAUDO TRIBUTARIO POR HABITANTE
# Colombia, 2002–2023
# 1. Construir resumen por municipio
sgp_recaudo <- base %>%
filter(
between(ano, 2002, 2023),
!is.na(codmpio),
is.finite(sgp_pc),
is.finite(recaudo_tributario_pc),
sgp_pc >= 0,
recaudo_tributario_pc >= 0
) %>%
group_by(codmpio) %>%
summarise(
municipio = first(municipio),
depto = first(depto),
anos_disponibles = n_distinct(ano),
sgp_pc_mediana = median(sgp_pc),
recaudo_pc_mediana = median(recaudo_tributario_pc),
.groups = "drop"
)
# 2. Revisar cobertura y distribución
sgp_recaudo %>%
summarise(
municipios = n(),
mediana_sgp_pc = median(sgp_pc_mediana),
mediana_recaudo_pc = median(recaudo_pc_mediana),
minimo_sgp = min(sgp_pc_mediana),
maximo_sgp = max(sgp_pc_mediana),
minimo_recaudo = min(recaudo_pc_mediana),
maximo_recaudo = max(recaudo_pc_mediana)
) %>%
print()
# 3. Gráfico de dispersión
figura_3a <- ggplot(
sgp_recaudo,
aes(
x = sgp_pc_mediana / 1e6,
y = recaudo_pc_mediana / 1e6
)
) +
geom_point(
color = "#8B1E2D",
size = 1.5,
alpha = 0.45
) +
geom_smooth(
method = "loess",
se = TRUE,
color = "#333333",
fill = "#D9D9D9",
linewidth = 0.9
) +
scale_x_continuous(
labels = scales::label_number(
decimal.mark = ","
)
) +
scale_y_continuous(
labels = scales::label_number(
decimal.mark = ","
)
) +
labs(
title = paste(
"Figura 3A. Transferencias del SGP y",
"recaudo tributario municipal"
),
subtitle = "Medianas municipales, Colombia, 2002–2023",
x = "SGP por habitante (millones de pesos corrientes)",
y = "Recaudo tributario por habitante (millones de pesos corrientes)",
caption = paste0(
"Nota: Cada punto representa un municipio. ",
"Se utilizan medianas municipales del período. ",
"La línea muestra una asociación descriptiva no causal. ",
"Las variables monetarias aún no están deflactadas.\n",
"Fuente: CEDE y TerriData. Cálculos propios."
)
) +
theme_classic(base_size = 12) +
theme(
text = element_text(family = "serif"),
plot.title = element_text(
size = 13,
face = "bold"
),
plot.subtitle = element_text(size = 11),
plot.caption = element_text(
size = 9,
hjust = 0
),
plot.margin = margin(15, 15, 15, 15)
)
print(figura_3a)
# 4. Exportar
ggsave(
filename = file.path(figures, "figura_3a_sgp_recaudo.png"),
plot = figura_3a,
width = 9,
height = 6,
dpi = 300,
bg = "white"
)
View(figura_3a)
