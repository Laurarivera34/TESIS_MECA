# Rutas del proyecto
root <- here::here() # Función here sirve para buscar la raíz de proyecto
data <- here::here("data", "raw")
processed <- here::here("data", "processed")
figures <- here::here("output", "figures")
tables <- here::here("output", "tables")
diagnostics <- here::here(
"output",
"tables",
"diagnostics"
)
# Importación de datos
panel_buen_gobierno <- read_excel(
file.path(
data,
"PANEL_BUEN_GOBIERNO(2024).xlsx"
)
)
caracteristicas_generales <- read_excel(
file.path(
data,
"PANEL_CARACTERISTICAS_GENERALES(2024).xlsx"
)
)
superfinanciera <- read_excel(
file.path(
data,
"Saldo_de_las_captaciones_y_colocaciones_por_municipios_20261009.xlsx"
)
)
dane <- read_excel(
file.path(
data,
"Listado_Departamentos_DANE.xlsx"
)
)
#### UNIÓN BASES CEDE
base_completa <- full_join(
caracteristicas_generales,
panel_buen_gobierno,
by = c("codmpio", "ano")
)
View(base_completa)
base_completa |>
count(codmpio, ano) |>
filter(n > 1)
View(superfinanciera)
View(dane)
# Estandarizar nombres
dane <- dane %>%
rename(
codmpio = `Código Municipio`,
municipio = `Nombre Municipio`
) %>%
mutate(
# Eliminar el cero inicial y convertir a número
codmpio = as.numeric(codmpio),
# Primera letra de cada palabra en mayúscula
municipio = str_to_title(
str_to_lower(
str_squish(municipio)
)
)
) %>%
select(codmpio, municipio) %>%
distinct()
View(dane)
# 2. PREPARAR SUPERFINANCIERA
superfinanciera <- superfinanciera %>%
rename(municipio = `Nombre del municipio`) %>%
mutate(
municipio = str_to_title(str_to_lower(str_squish(municipio))),
ano = as.integer(substr(as.character(`Fecha de Corte`), 1, 4))
) %>%
filter(
!is.na(municipio),
municipio != "",
!str_detect(str_to_lower(municipio), "\\btotal\\b")
)
# Nombres de la superfinanciera
# Nombres del CEDE con sus tildes
nombres_cede <- base_completa %>%
filter(!is.na(municipio)) %>%
transmute(
llave = stri_trans_general(
str_to_lower(str_squish(municipio)), "Latin-ASCII"
),
nombre_cede = municipio
) %>%
distinct()
View(dane)
View(superfinanciera)
superfinanciera <- superfinanciera %>%
mutate(municipio = str_to_title(str_to_lower(str_squish(municipio))))
superfinanciera <- superfinanciera %>%
mutate(llave = stringi::stri_trans_general(
str_to_lower(str_squish(municipio)), "Latin-ASCII"
)) %>%
left_join(
dane %>%
transmute(
llave = stringi::stri_trans_general(
str_to_lower(str_squish(municipio)), "Latin-ASCII"
),
codmpio,
municipio_dane = municipio
) %>%
distinct(),
by = "llave",
relationship = "many-to-one"
) %>%
mutate(municipio = coalesce(municipio_dane, municipio)) %>%
select(-llave, -municipio_dane)
