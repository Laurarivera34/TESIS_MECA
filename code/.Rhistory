base_municipal,
file.path(processed, "base_municipal.rds")
)
saveRDS(
ejecuciones_departamentos,
file.path(processed, "ejecuciones_departamentos.rds")
)
saveRDS(
ejecuciones_municipios,
file.path(processed, "ejecuciones_municipios.rds")
)
