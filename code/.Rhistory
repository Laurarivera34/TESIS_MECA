# 1. Clasificar los municipios según el saldo estimado de 2023
tolerancia_deuda <- 1e-8
deuda_municipal_2023 <- base %>%
filter(ano == 2023, !is.na(codmpio)) %>%
transmute(
codigo_dane = stringr::str_pad(
trimws(as.character(codmpio)), width = 5, pad = "0"
),
deuda_proxy
) %>%
distinct() %>%
mutate(
estado_deuda = case_when(
!is.finite(deuda_proxy) ~ NA_character_,
deuda_proxy > tolerancia_deuda ~ "Sí",
abs(deuda_proxy) <= tolerancia_deuda ~ "No",
TRUE ~ NA_character_
)
)
if (anyDuplicated(deuda_municipal_2023$codigo_dane) > 0L) {
stop("Hay municipios con más de un valor de deuda_proxy en 2023.")
}
# 2. Leer la misma cartografía municipal de la Parte 5
ruta_municipios <- here::here(
"data", "raw", "MGN_ADM_MPIO_GRAFICO (Geopackage).gpkg"
)
municipios_col <- sf::st_read(ruta_municipios, quiet = TRUE)
# 3. Unir la clasificación a los polígonos municipales
mapa_deuda_2023 <- municipios_col %>%
mutate(
codigo_dane = stringr::str_pad(
trimws(as.character(mpio_cdpmp)), width = 5, pad = "0"
)
) %>%
left_join(
select(deuda_municipal_2023, codigo_dane, estado_deuda),
by = "codigo_dane",
relationship = "many-to-one"
) %>%
mutate(estado_deuda = factor(estado_deuda, levels = c("Sí", "No")))
# Revisar cuántos municipios quedaron en cada categoría
mapa_deuda_2023 %>%
sf::st_drop_geometry() %>%
distinct(codigo_dane, estado_deuda) %>%
count(estado_deuda, name = "municipios") %>%
print()
# 4. Dibujar el mapa
grafico_mapa_deuda_2023 <- ggplot(mapa_deuda_2023) +
geom_sf(
aes(fill = estado_deuda),
colour = "#AAB2BE",
linewidth = 0.12
) +
scale_fill_manual(
values = c("Sí" = "#193C8C", "No" = "#C9CED6"),
breaks = c("Sí", "No"),
na.value = "transparent",
na.translate = FALSE,
drop = FALSE
) +
labs(
title = "Deuda pública municipal estimada, 2023",
fill = "¿Posee deuda pública?\nSegún saldo estimado",
caption = paste(
"Fuente: CEDE y DANE (cartografía municipal). Cálculos propios.",
"Nota. «Sí» indica saldo estimado positivo y «No» indica saldo estimado cero.",
"Los polígonos sin clasificación quedan sin relleno.",
sep = "\n"
)
) +
theme_void(base_size = 12) +
theme(
plot.title = element_text(face = "bold", margin = margin(b = 10)),
legend.position = "right",
legend.key.size = grid::unit(4, "mm"),
plot.caption = element_text(
colour = "grey35", hjust = 0, margin = margin(t = 8)
),
plot.margin = margin(12, 12, 12, 12)
)
print(grafico_mapa_deuda_2023)
# 5. Guardar en la carpeta existente output/figures
ruta_mapa <- file.path(figures, "mapa_deuda_proxy_municipal_2023.png")
ggsave(
filename = ruta_mapa,
plot = grafico_mapa_deuda_2023,
width = 8,
height = 7,
dpi = 300,
bg = "white"
)
# 1. Clasificar los municipios según sus desembolsos de 2023
desembolsos_municipales_2023 <- base %>%
filter(ano == 2023, !is.na(codmpio)) %>%
transmute(
codigo_dane = stringr::str_pad(
trimws(as.character(codmpio)), width = 5, pad = "0"
),
finan_credito_desemb
) %>%
distinct() %>%
mutate(
recibio_desembolsos = case_when(
!is.finite(finan_credito_desemb) ~ NA_character_,
finan_credito_desemb > 0 ~ "Sí",
finan_credito_desemb == 0 ~ "No",
TRUE ~ NA_character_
)
)
if (anyDuplicated(desembolsos_municipales_2023$codigo_dane) > 0L) {
stop("Hay municipios con más de un valor de desembolsos en 2023.")
}
# 2. Leer la misma cartografía municipal de la Parte 5
ruta_municipios <- here::here(
"data", "raw", "MGN_ADM_MPIO_GRAFICO (Geopackage).gpkg"
)
municipios_col <- sf::st_read(ruta_municipios, quiet = TRUE)
# 3. Unir la clasificación a los polígonos
mapa_desembolsos_2023 <- municipios_col %>%
mutate(
codigo_dane = stringr::str_pad(
trimws(as.character(mpio_cdpmp)), width = 5, pad = "0"
)
) %>%
left_join(
select(desembolsos_municipales_2023, codigo_dane, recibio_desembolsos),
by = "codigo_dane",
relationship = "many-to-one"
) %>%
mutate(
recibio_desembolsos = factor(recibio_desembolsos, levels = c("Sí", "No"))
)
# Revisar la cobertura del mapa
mapa_desembolsos_2023 %>%
sf::st_drop_geometry() %>%
distinct(codigo_dane, recibio_desembolsos) %>%
count(recibio_desembolsos, name = "municipios") %>%
print()
# 4. Dibujar el mapa
grafico_mapa_desembolsos_2023 <- ggplot(mapa_desembolsos_2023) +
geom_sf(
aes(fill = recibio_desembolsos),
colour = "#AAB2BE",
linewidth = 0.12
) +
scale_fill_manual(
values = c("Sí" = "#193C8C", "No" = "#C9CED6"),
breaks = c("Sí", "No"),
na.value = "transparent",
na.translate = FALSE,
drop = FALSE
) +
labs(
title = "Desembolsos de crédito municipal, 2023",
fill = "¿Recibió desembolsos?",
caption = paste(
"Fuente: CEDE y DANE (cartografía municipal). Cálculos propios.",
"Nota. «Sí» indica un monto positivo y «No» un cero registrado.",
"Los polígonos sin dato válido quedan sin relleno.",
sep = "\n"
)
) +
theme_void(base_size = 12) +
theme(
plot.title = element_text(face = "bold", margin = margin(b = 10)),
legend.position = "right",
legend.key.size = grid::unit(4, "mm"),
plot.caption = element_text(
colour = "grey35", hjust = 0, margin = margin(t = 8)
),
plot.margin = margin(12, 12, 12, 12)
)
print(grafico_mapa_desembolsos_2023)
# 5. Guardar en la carpeta existente output/figures
ggsave(
filename = file.path(figures, "mapa_desembolsos_credito_municipal_2023.png"),
plot = grafico_mapa_desembolsos_2023,
width = 8,
height = 7,
dpi = 300,
bg = "white"
)
