# ================================================================
# 15. BOXPLOTS PARA IDENTIFICAR VALORES EXTREMOS
# ================================================================
graficar_boxplot <- function(
data,
variable,
nombre_archivo
) {
p <- ggplot(
data,
aes(
y = .data[[variable]]
)
) +
geom_boxplot(
na.rm = TRUE
) +
labs(
title = paste(
"Valores extremos de",
variable
),
y = variable,
x = NULL
) +
theme_minimal()
ggsave(
file.path(
figures,
nombre_archivo
),
p,
width = 6,
height = 5,
dpi = 300
)
}
