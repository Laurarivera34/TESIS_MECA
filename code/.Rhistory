################ SEGUNDA PARTE: CATEGORÍAS LEY 617
# Distribución de observaciones municipio-año por categoría
categorias_617 <- base %>%
filter(!is.na(categ_cgn)) %>%
count(categ_cgn, name = "Observaciones") %>%
mutate(
Porcentaje = 100 * Observaciones / sum(Observaciones)
) %>%
arrange(categ_cgn)
# Visualizar resultados
print(categorias_617, n = Inf)
# Tabla estilo AER
tabla_617 <- categorias_617 %>%
gt::gt() %>%
gt::tab_header(
title = "Tabla 2. Distribución de observaciones por categoría municipal"
) %>%
gt::cols_label(
categ_cgn = "Categoría Ley 617",
Observaciones = "Observaciones",
Porcentaje = "Participación (%)"
) %>%
gt::fmt_number(
columns = Observaciones,
decimals = 0,
sep_mark = ","
) %>%
gt::fmt_number(
columns = Porcentaje,
decimals = 2,
dec_mark = "."
) %>%
gt::cols_align(
align = "center",
columns = everything()
) %>%
gt::tab_source_note(
source_note = gt::html(
paste0(
"<i>Nota:</i> Cada observación corresponde a un ",
"municipio-año. Se excluyen únicamente los registros ",
"sin categoría disponible para esta tabla. ",
"Un municipio puede cambiar de categoría durante ",
"el período de análisis."
)
)
) %>%
gt::tab_options(
table.font.names = "Times New Roman",
table.font.size = gt::px(12),
heading.align = "left",
heading.title.font.size = gt::px(14),
heading.title.font.weight = "normal",
table.border.top.color = "black",
table.border.top.width = gt::px(1.5),
table.border.bottom.style = "none",
