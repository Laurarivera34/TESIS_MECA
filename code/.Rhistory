# 15. Cobertura anual de las variables del modelo de sostenibilidad
cobertura_sost <- aggregate(
cbind(
registros = rep(1L, nrow(panel)),
con_deuda_proxy = as.integer(is.finite(panel$deuda_proxy)),
con_ingresos_previos_positivos = as.integer(
is.finite(panel$ingresos_corrientes_previos) &
panel$ingresos_corrientes_previos > 0
),
con_sostenibilidad = as.integer(is.finite(panel$sostenibilidad_proxy)),
con_sostenibilidad_y_sgp = as.integer(
is.finite(panel$sostenibilidad_proxy) & is.finite(panel$sgp_pc_real2023)
)
),
by = list(ano = panel$ano),
FUN = sum
)
print(cobertura_sost, row.names = FALSE)
# 16. Modelos de crédito en la muestra de sostenibilidad
panel_sost <- subset(
panel,
is.finite(sostenibilidad_proxy) & is.finite(sgp_pc_real2023)
)
modelo_desembolsos_muestra_sost <- update(
modelo_desembolsos,
data = panel_sost
)
modelo_uso_muestra_sost <- update(
modelo_uso_credito,
data = panel_sost
)
fixest::etable(
modelo_desembolsos,
modelo_desembolsos_muestra_sost,
modelo_uso_credito,
modelo_uso_muestra_sost,
headers = c("Muestra amplia", "Muestra sostenibilidad",
"Muestra amplia", "Muestra sostenibilidad"),
dict = c(sgp_pc_real2023 = "SGP por habitante")
)
