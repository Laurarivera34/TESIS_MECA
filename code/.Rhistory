labels = formatC(montos, format = "f", digits = 2, decimal.mark = ","),
pos = 4, offset = 0.35, cex = 0.8, col = "#25282D")
mtext("Figura 1. Desembolsos de crédito municipal",
side = 3, line = 2.2, adj = 0, font = 2, cex = 1)
mtext(paste0("Diez municipios con mayores desembolsos acumulados, ", periodo),
side = 3, line = 1, adj = 0, col = "#6B7280", cex = 0.8)
mtext("Fuente: CEDE.",
side = 1, line = 4.3, adj = 0, col = "#6B7280", cex = 0.72)
grafico <- recordPlot()
withr::with_png(
file.path(figures, "figura_01_desembolsos_top10.png"),
replayPlot(grafico),
width = 10, height = 6, units = "in", res = 300
)
withr::with_pdf(
file.path(figures, "figura_01_desembolsos_top10.pdf"),
replayPlot(grafico),
width = 10, height = 6
)
############## PARTE 3. # Figura 2. Municipios con menores desembolsos acumulados
top10_menores <- panel_desembolsos %>%
group_by(codmpio) %>%
summarise(
municipio = last(municipio, order_by = ano, na_rm = TRUE),
depto = last(depto, order_by = ano, na_rm = TRUE),
desembolsos_millones = sum(finan_credito_desemb_real2023),
.groups = "drop"
) %>%
arrange(desembolsos_millones, codmpio) %>%
slice_head(n = 10) %>%
mutate(
nombre = stringr::str_to_title(municipio, locale = "es"),
etiqueta = if_else(
is.na(depto), nombre,
paste0(nombre, " (", stringr::str_to_title(depto, locale = "es"), ")")
)
)
montos <- rev(top10_menores$desembolsos_millones)
periodo <- paste(range(panel_desembolsos$ano), collapse = "–")
par(mar = c(5.5, 15, 4, 2), bg = "white")
pos <- barplot(
montos,
names.arg = rev(top10_menores$etiqueta),
horiz = TRUE, las = 1, cex.names = 0.8,
col = "#A3ABB5", border = NA,
xlim = c(min(0, montos) * 1.15, max(1, montos) * 1.18),
xlab = "Millones de pesos constantes de 2023"
)
text(montos, pos,
labels = formatC(montos, format = "f", digits = 2,
big.mark = ".", decimal.mark = ","),
pos = ifelse(montos < 0, 2, 4), offset = 0.35, cex = 0.8)
mtext("Figura 2. Desembolsos de crédito municipal",
side = 3, line = 2.2, adj = 0, font = 2)
mtext(paste0("Diez municipios con menores desembolsos acumulados, ", periodo),
side = 3, line = 1, adj = 0, col = "#6B7280", cex = 0.8)
mtext("Fuentes: CEDE y Banco de la República. Suma de los años con datos disponibles.",
side = 1, line = 4.3, adj = 0, col = "#6B7280", cex = 0.72)
grafico_2 <- recordPlot()
withr::with_png(
file.path(figures, "figura_02_desembolsos_menores.png"),
replayPlot(grafico_2),
width = 10, height = 6, units = "in", res = 300
)
withr::with_pdf(
file.path(figures, "figura_02_desembolsos_menores.pdf"),
replayPlot(grafico_2),
width = 10, height = 6
)
############## PARTE 3.
# Tabla 2. Municipios según registro de desembolsos, 2000–2023
tabla_2 <- base %>%
filter(between(ano, 2000, 2023), !is.na(codmpio)) %>%
group_by(codmpio) %>%
summarise(
anios_con_dato = n_distinct(ano[is.finite(finan_credito_desemb_real2023)]),
con_positivo = any(finan_credito_desemb_real2023 > 0, na.rm = TRUE),
con_negativo = any(finan_credito_desemb_real2023 < 0, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(
grupo = case_when(
anios_con_dato == 0 ~ "Sin información",
con_positivo ~ "Con desembolsos positivos",
con_negativo ~ "Registros negativos sin desembolsos positivos",
anios_con_dato == 24 ~ "Cero desembolsos · cobertura completa",
TRUE ~ "Cero desembolsos · cobertura parcial"
),
grupo = factor(grupo, levels = c(
"Con desembolsos positivos",
"Cero desembolsos · cobertura completa",
"Cero desembolsos · cobertura parcial",
"Sin información",
"Registros negativos sin desembolsos positivos"
))
) %>%
count(grupo, name = "municipios", .drop = FALSE) %>%
filter(grupo != "Registros negativos sin desembolsos positivos" | municipios > 0) %>%
mutate(proporcion = municipios / sum(municipios))
tabla_2 %>%
gt::gt() %>%
gt::tab_header(
title = "Tabla 2. Municipios según registro de desembolsos",
subtitle = "Colombia, 2000–2023"
) %>%
gt::cols_label(
grupo = "Registro de desembolsos",
municipios = "Municipios",
proporcion = "% del total"
) %>%
gt::fmt_percent(columns = proporcion, decimals = 1, dec_mark = ",") %>%
gt::tab_source_note(
"Cobertura completa: 24 años con datos. Los ceros corresponden a años observados. Fuente: CEDE."
)
############## PARTE 3.
setdiff(2000:2023, base$ano)
############## PARTE 3.
tabla_2_final <- tabla_2 %>%
mutate(
grupo = case_when(
grepl("^Cero desembolsos", grupo) ~ "Cero desembolsos en los años observados",
grupo == "Con desembolsos positivos" ~ "Con algún desembolso positivo",
TRUE ~ as.character(grupo)
)
) %>%
group_by(grupo) %>%
summarise(municipios = sum(municipios), .groups = "drop") %>%
arrange(match(grupo, c(
"Con algún desembolso positivo",
"Cero desembolsos en los años observados",
"Sin información"
))) %>%
mutate(proporcion = municipios / sum(municipios))
tabla_2_final %>%
bind_rows(tibble(
grupo = "Total",
municipios = sum(tabla_2_final$municipios),
proporcion = 1
)) %>%
gt::gt() %>%
gt::tab_header(
title = gt::md("**Tabla 2. Registro de desembolsos municipales**"),
subtitle = "Colombia, 2000–2023"
) %>%
gt::cols_label(
grupo = "Registro de desembolsos",
municipios = "Municipios",
proporcion = "% del total"
) %>%
gt::cols_align(align = "left", columns = grupo) %>%
gt::cols_align(align = "right", columns = c(municipios, proporcion)) %>%
gt::fmt_number(columns = municipios, decimals = 0, sep_mark = ".") %>%
gt::fmt_percent(columns = proporcion, decimals = 1, dec_mark = ",") %>%
gt::tab_style(
style = gt::cell_text(weight = "bold"),
locations = gt::cells_body(rows = grupo == "Total")
) %>%
gt::tab_options(
heading.align = "left",
table.font.size = gt::px(13),
data_row.padding = gt::px(6),
table_body.hlines.style = "none"
) %>%
gt::tab_source_note(
"Nota. Los ceros corresponden a años con información disponible. Fuente. CEDE."
)
# TABLA 2. Registro de desembolsos municipales, 2000–2023
registro_municipal <- base %>%
filter(between(ano, 2000, 2023), !is.na(codmpio)) %>%
group_by(codmpio) %>%
summarise(
anios_con_dato = n_distinct(ano[is.finite(finan_credito_desemb_real2023)]),
con_positivo = any(is.finite(finan_credito_desemb_real2023) &
finan_credito_desemb_real2023 > 0),
con_negativo = any(is.finite(finan_credito_desemb_real2023) &
finan_credito_desemb_real2023 < 0),
.groups = "drop"
) %>%
mutate(
grupo = case_when(
anios_con_dato == 0 ~ "Sin información",
con_positivo ~ "Con algún desembolso positivo",
con_negativo ~ "Registros negativos sin desembolsos positivos",
TRUE ~ "Cero desembolsos en los años con datos"
),
grupo = factor(grupo, levels = c(
"Con algún desembolso positivo",
"Cero desembolsos en los años con datos",
"Sin información",
"Registros negativos sin desembolsos positivos"
))
)
total_municipios <- nrow(registro_municipal)
ceros_parciales <- sum(
registro_municipal$grupo == "Cero desembolsos en los años con datos" &
registro_municipal$anios_con_dato < 24
)
tabla_2 <- registro_municipal %>%
count(grupo, name = "municipios") %>%
arrange(grupo) %>%
mutate(
grupo = as.character(grupo),
proporcion = municipios / total_municipios
) %>%
bind_rows(tibble(
grupo = "Total",
municipios = total_municipios,
proporcion = 1
))
tabla_2_gt <- tabla_2 %>%
gt::gt() %>%
gt::tab_header(
title = gt::md("**Tabla 2. Registro de desembolsos municipales**"),
subtitle = "Colombia, 2000–2023"
) %>%
gt::cols_label(
grupo = "Registro de desembolsos",
municipios = "Municipios",
proporcion = "% del total"
) %>%
gt::cols_align(align = "left", columns = grupo) %>%
gt::cols_align(align = "right", columns = c(municipios, proporcion)) %>%
gt::fmt_number(
columns = municipios, decimals = 0, sep_mark = ".", dec_mark = ","
) %>%
gt::fmt_percent(
columns = proporcion, decimals = 1, sep_mark = ".", dec_mark = ","
) %>%
gt::tab_style(
style = gt::cell_text(weight = "bold"),
locations = gt::cells_column_labels(columns = c(grupo, municipios, proporcion))
) %>%
gt::tab_style(
style = gt::cell_text(weight = "bold"),
locations = gt::cells_body(rows = grupo == "Total")
) %>%
gt::tab_options(
heading.align = "left",
table.font.size = gt::px(13),
data_row.padding = gt::px(6),
table_body.hlines.style = "none"
) %>%
gt::tab_source_note(gt::md(
"**Fuente:** Panel de Buen Gobierno del CEDE. Cálculos propios."
)) %>%
gt::tab_source_note(gt::md(paste0(
"**Notas:** El porcentaje se calcula sobre los ",
format(total_municipios, big.mark = ".", decimal.mark = ","),
" municipios de la base. ",
ceros_parciales,
" municipios con cero desembolsos tienen datos para menos de 24 años. ",
"«Sin información» agrupa a los municipios sin datos de desembolsos en todo el periodo."
)))
tabla_2_gt
