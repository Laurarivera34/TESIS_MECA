root <- here::here() # Función here sirve para buscar la raíz de proyecto
data <- here::here("data", "raw")
processed <- here::here("data", "processed")
figures <- here::here("output", "figures")
tables <- here::here("output", "tables")
diagnostics <- here::here(
"output",
"tables",
"diagnostics"
)
# 4. IMPORTACIÓN DE DATOS
panel_buen_gobierno <- read_excel(
file.path(
data,
"PANEL_BUEN_GOBIERNO(2024).xlsx"
)
)
caracteristicas_generales <- read_excel(
file.path(
data,
"PANEL_CARACTERISTICAS_GENERALES(2024).xlsx"
)
)
terridata <- read_excel(
file.path(
data,
"TerriData_Dim7_2024.xlsx"
),
col_types = "text"
)
ejecuciones_municipios <- haven::read_dta(
file.path(
data,
"Ejecuciones_Municipios_PANEL_1984_2023.dta"
)
)
ejecuciones_departamentos <- haven::read_dta(
file.path(
data,
"Ejecuciones_Departamentos_PANEL_1984_2023.dta"
)
)
#### SEGUNDA PARTE: REVISIÓN DE NOMBRES DE VARIABLES
# 1. Panel Buen Gobierno
names(panel_buen_gobierno)
# 2. Características Generales
names(caracteristicas_generales)
# 3. TerriData
names(terridata)
# 4. Ejecuciones municipales
names(ejecuciones_municipios)
# 5. Ejecuciones departamentales
names(ejecuciones_departamentos)
#### TERCERA PARTE: ESTANDARIZACIÓN DE NOMBRES DE IDENTIFICADORES
# 1. CARACTERÍSTICAS GENERALES
caracteristicas_generales <- caracteristicas_generales %>%
rename(
departamento = depto
)
# 2. EJECUCIONES DEPARTAMENTALES
ejecuciones_departamentos <- ejecuciones_departamentos %>%
rename(
coddepto = cod_dpto,
ano = year
)
# 3. EJECUCIONES MUNICIPALES
ejecuciones_municipios <- ejecuciones_municipios %>%
rename(
coddepto = cod_dpto,
codmpio = cod_mpios,
ano = year
)
# 4. TERRIDATA
terridata <- terridata %>%
rename(
coddepto = `Código Departamento`,
departamento = Departamento,
codmpio = `Código Entidad`,
municipio = Entidad,
ano = `Año`
)
#### CUARTA PARTE: UNIÓN DE LAS BASES MUNICIPALES
# Se une las dos bases de los Andes
base_municipal <- full_join(
caracteristicas_generales,
panel_buen_gobierno,
by = c("codmpio", "ano"),
na_matches = "never",
relationship = "one-to-one"
) %>%
relocate(codmpio, coddepto, municipio, departamento, ano) %>%
arrange(codmpio, ano)
View(base_municipal)
# Pasar de formato largo a ancho Terridata
terridata_ancha <- terridata %>%
select(
codmpio,
coddepto,
municipio,
departamento,
ano,
Indicador,
`Dato Numérico`
) %>%
pivot_wider(
id_cols = c(
codmpio, coddepto, municipio, departamento, ano
),
names_from = Indicador,
values_from = `Dato Numérico`
)
View(terridata_ancha)
observaciones_terridata <- purrr::imap_dfr(
terridata_ancha,
function(x, nombre) {
valores <- str_trim(as.character(x))
faltante <- is.na(valores) |
valores == "" |
str_to_upper(valores) == "NULL"
tibble(
variable = nombre,
total_observaciones = length(x),
con_informacion = sum(!faltante),
sin_informacion = sum(faltante),
porcentaje_disponible = round(
100 * mean(!faltante), 2
)
)
}
) %>%
arrange(desc(con_informacion))
View(observaciones_terridata)
variables_td_interes <- c(
# Identificadores
"codmpio",
"coddepto",
"municipio",
"departamento",
"ano",
# Ingresos
"Ingresos totales",
"Ingresos corrientes",
"Ingresos tributarios",
"Ingresos no tributarios",
"Ingresos de capital",
# Transferencias
"Transferencias de los ingresos corrientes",
"Transferencias nacionales (SGP, etc.) per cápita",
"Total de recursos asignados per cápita - SGP",
# Componentes sectoriales: definición pendiente de verificar
"Educación",
"Salud",
"Agua potable",
# Gastos
"Gastos totales",
"Gastos corrientes",
"Funcionamiento",
"Gastos de capital (Inversión)",
# Intereses y balances
"Intereses de deuda pública",
"Déficit o ahorro corriente",
"Déficit o superávit total",
# Regalías
"Regalías per cápita (Valor efectivamente girado al municipio)"
)
terridata_seleccion <- terridata_ancha %>%
select(all_of(variables_td_interes))
View(terridata_seleccion)
#Cuales llegan a 2024
cobertura_td_interes <- terridata_seleccion %>%
mutate(ano = as.integer(ano)) %>%
filter(between(ano, 2000, 2024)) %>%
group_by(ano) %>%
summarise(
registros = n(),
across(
-any_of(c("codmpio", "coddepto", "municipio", "departamento")),
~ {
x <- str_trim(as.character(.x))
sum(
!is.na(x) &
x != "" &
str_to_upper(x) != "NULL"
)
}
),
.groups = "drop"
) %>%
pivot_longer(
cols = -c(ano, registros),
names_to = "variable",
values_to = "con_informacion"
) %>%
mutate(
porcentaje_disponible = round(
100 * con_informacion / registros, 2
)
) %>%
arrange(variable, ano)
# Cobertura de las variables en 2024
cobertura_td_interes %>%
filter(ano == 2024) %>%
View()
View(panel_buen_gobierno)
# Se renombra
terridata_ancha <- terridata_ancha %>%
rename(
y_total_td = `Ingresos totales`,
y_corr_td = `Ingresos corrientes`,
y_transf_td = `Transferencias de los ingresos corrientes`,
y_corr_tribut_td = `Ingresos tributarios`,
y_no_tribut_td = `Ingresos no tributarios`,
g_total_td = `Gastos totales`,
g_corr_td = `Gastos corrientes`,
g_func_td = Funcionamiento,
g_int_deudap_td = `Intereses de deuda pública`,
y_cap_td = `Ingresos de capital`,
g_cap_td = `Gastos de capital (Inversión)`,
deficit_td = `Déficit o ahorro corriente`,
deficit_total_td = `Déficit o superávit total`,
finan_td = Financiamiento
)
View(terridata_ancha)
# Se renombra
terridata_ancha <- terridata_ancha %>%
rename(
y_total_td = `Ingresos totales`,
y_corr_td = `Ingresos corrientes`,
y_transf_td = `Transferencias de los ingresos corrientes`,
y_corr_tribut_td = `Ingresos tributarios`,
y_no_tribut_td = `Ingresos no tributarios`,
g_total_td = `Gastos totales`,
g_corr_td = `Gastos corrientes`,
g_func_td = Funcionamiento,
g_int_deudap_td = `Intereses de deuda pública`,
y_cap_td = `Ingresos de capital`,
g_cap_td = `Gastos de capital (Inversión)`,
deficit_td = `Déficit o ahorro corriente`,
deficit_total_td = `Déficit o superávit total`,
finan_td = Financiamiento
)
View(terridata_ancha)
View(panel_buen_gobierno)
# Comparar ingresos corrientes de ambas fuentes
comparacion_ingresos <- base_municipal %>%
select(
codmpio,
municipio,
ano,
ingresos_corrientes_andes = y_corr,
ingresos_corrientes_terridata = `Ingresos corrientes`
) %>%
arrange(codmpio, ano)
View(base_municipal)
